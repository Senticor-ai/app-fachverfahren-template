{
  "name": "@senticor/fachverfahren",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Klickbare Referenz-App: KOMPOSITION aus @senticor/fachverfahren-kit (fertige Bausteine) + der EINEN LeistungConfig (src/leistung.config.ts — die Austausch-Naht, die der governte Build überschreibt). Keine fachliche Logik hier — nur Routing + die EINE Store-Instanz + die Config.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "mesh": "node dist-server/dev/mesh-cli.js",
    "worker:deadlines": "node dist-server/deadline-worker.js",
    "worker:mahnung": "node dist-server/forderung-mahnung.js",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "emit:contract": "node --experimental-strip-types ./scripts/emit-contract.mts",
    "emit:procedure-contract": "node --experimental-strip-types ./scripts/emit-procedure-contract.mts",
    "emit:docs": "node --experimental-strip-types ./scripts/emit-docs-manifest.mts"
  },
  "dependencies": {
    "@fastify/cookie": "catalog:",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@senticor/app-bff-contracts": "workspace:*",
    "@senticor/app-bff-fastify": "workspace:*",
    "@senticor/app-runtime-fastify": "workspace:*",
    "@senticor/app-store-postgres": "workspace:*",
    "@senticor/fachverfahren-kit": "workspace:*",
    "@senticor/platform-contracts": "workspace:*",
    "@senticor/provider-ai-ollama": "workspace:*",
    "@senticor/provider-local-auth": "workspace:*",
    "@senticor/public-sector-sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "fastify": "catalog:",
    "jose": "^5.9.6",
    "lucide-react": "^1.24.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.1",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.2",
    "typescript": "6.0.3",
    "vite": "^8.1.4"
  },
  "chos": {
    "runtime": {
      "//": "Laufzeit-Descriptor (DIE EINE Wahrheit, welche Prozesse die App zum Laufen braucht) — vom CHOS-Preview-Boot + Boot-Smoke-Gate gelesen. Neben dem Vite-Frontend hat diese App ein Fastify-Backend (dist-server). Eine App OHNE Backend lässt diesen Block weg → nur das Frontend bootet.",
      "backend": {
        "prepareScript": "build:server",
        "startScript": "start",
        "portEnv": "PORT",
        "defaultPort": 8080,
        "extraPorts": [
          {
            "env": "INTERNAL_PORT",
            "defaultPort": 9090
          }
        ],
        "healthPath": "/auth/status",
        "gateProbePath": "/auth/session",
        "proxyTargetEnv": "VITE_DEV_API_PROXY_TARGET",
        "staticDirEnv": "STATIC_DIR",
        "previewEnv": {
          "APP_STORE_MODE": "memory"
        }
      }
    },
    "seam": {
      "//": "THE DOMAIN SEAM OF THIS APP — the files that legitimately carry procedure vocabulary although they live outside modules/<domain>. `leistung.config.ts` is, in this kit's own words, 'DIE EINE Austausch-Naht dieser App'; the other three are generated FROM it. The domain-leakage gate protects SHARED code from hard-coded vocabulary — the seam is by design not shared, and reading this declaration is what keeps that distinction honest. Paths are relative to this app directory, so they survive the scaffold rename. Absent => nothing is exempt (the previous behaviour).",
      "files": [
        "src/leistung.config.ts",
        "leistung.contract.json",
        "public/leistung.contract.json",
        "public/runtime-config.json"
      ]
    }
  }
}
